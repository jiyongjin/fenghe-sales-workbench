{
  "name": "fenghe-sales-workbench",
  "version": "4.0.0",
  "private": true,
  "license": "MIT",
  "description": "Local-first B2B sales workbench with CSV persistence and portable agent workflows.",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vite --config vite.local.config.ts",
    "build": "vite build --config vite.local.config.ts",
    "build:local": "vite build --config vite.local.config.ts",
    "start": "node server/local.mjs",
    "start:local": "node server/local.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
